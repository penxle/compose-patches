+package androidx.compose.ui.window
+
+import androidx.compose.ui.unit.dp
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.useContents
+import platform.CoreGraphics.CGRectMake
+import platform.Foundation.NSDate
+import platform.Foundation.NSRunLoop
+import platform.Foundation.dateWithTimeIntervalSinceNow
+import platform.Foundation.runUntilDate
+import platform.UIKit.UIScreen
+import platform.UIKit.UIView
+import platform.UIKit.UIViewAnimationOptionCurveLinear
+import platform.UIKit.UIWindow
+
+@OptIn(ExperimentalForeignApi::class)
+class ComposeSceneKeyboardOffsetManagerTest {
+    @Test
+    fun zeroDurationKeyboardFrameIsAppliedSynchronously() {
+        val screenBounds = UIScreen.mainScreen.bounds
+        val window = UIWindow(frame = screenBounds)
+        val view = UIView(frame = screenBounds)
+        window.addSubview(view)
+        var overlap = (-1).dp
+        val manager = ComposeSceneKeyboardOffsetManager(view) { overlap = it }
+        val targetHeight = 200.0
+        val targetFrame = screenBounds.useContents {
+            CGRectMake(0.0, size.height - targetHeight, maxOf(1.0, size.width), targetHeight)
+        }
+
+        manager.keyboardWillChangeFrame(
+            targetFrame = targetFrame,
+            duration = 0.0,
+            animationOptions = UIViewAnimationOptionCurveLinear
+        )
+        val appliedSynchronously = overlap
+        val startedAnimation = manager.isAnimating
+
+        NSRunLoop.currentRunLoop.runUntilDate(NSDate.dateWithTimeIntervalSinceNow(0.1))
+        manager.dispose()
+        window.hidden = true
+
+        assertEquals(targetHeight.dp, appliedSynchronously)
+        assertFalse(startedAnimation)
+    }
+}
