+        connection.start(request)
+        request.afterEdit = {
+            request.afterEdit = { connection.onTextFieldValueUpdated(request.value()) }
+            connection.insertText("X")
+            connection.flushPendingTextInputEdits()
+            request.afterEdit = {}
+
+            // The host changes its value after the nested native batch has completed.
+            request.editText { commitText("Y", 1) }
+            if (synchronousSnapshot) {
+                connection.onTextFieldValueUpdated(request.value())
+            } else {
+                launch { connection.onTextFieldValueUpdated(request.value()) }
+            }
+        }
+
+        connection.setSelectedTextRange(TextRange(1))
+        connection.flushPendingTextInputEdits()
+        runCurrent()
+
+        assertEquals(TextFieldValue("aXYb", TextRange(3)), request.value())
+        assertEquals("aXYb", connection.textInRange(TextRange(0, connection.endOfDocument())))
+        assertEquals(TextRange(3), connection.getSelectedTextRange())
+
+        connection.insertText("Z")
+        runCurrent()
+
+        assertEquals(TextFieldValue("aXYZb", TextRange(4)), request.value())
+        assertEquals(listOf(true to true), connection.stateWillChanges)
+        assertEquals(listOf(true to true), connection.stateDidChanges)
+    }
