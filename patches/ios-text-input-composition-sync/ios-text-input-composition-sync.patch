+    @Test
+    fun escapeKeepsFocusUntilANewPressAfterCompositionEnds() = runTest {
+        val frameRecomposer = FrameRecomposer(coroutineContext)
+        val scene = CanvasLayersComposeScene(frameRecomposer = frameRecomposer)
+        val connection =
+            TestTextInputConnection(CoroutineScope(coroutineContext)) { scene.focusManager }
+        try {
+            val focusRequester = FocusRequester()
+            scene.setContent {
+                Layout(
+                    content = {},
+                    modifier = Modifier.focusRequester(focusRequester).focusTarget(),
+                ) { _, _ ->
+                    layout(10, 10) {}
+                }
+            }
+            scene.measureAndLayout()
+            assertTrue(focusRequester.requestFocus())
+            assertTrue(scene.focusManager.hasFocus)
+
+            val down = KeyEvent(key = Key.Escape, type = KeyEventType.KeyDown)
+            val up = KeyEvent(key = Key.Escape, type = KeyEventType.KeyUp)
+            assertFalse(connection.onPreviewKeyEvent(down))
+            assertTrue(scene.focusManager.hasFocus)
+
+            connection.start(TestRequest(TextFieldValue("にほん", TextRange(3), TextRange(0, 3))))
+            assertTrue(connection.onPreviewKeyEvent(down))
+            assertTrue(scene.focusManager.hasFocus)
+
+            // UIKit handles the press and ends composition before releasing the key.
+            connection.unmarkText()
+            runCurrent()
+            assertEquals(null, connection.markedTextRange())
+            assertTrue(connection.onPreviewKeyEvent(up))
+            assertTrue(scene.focusManager.hasFocus)
+
+            assertTrue(connection.onPreviewKeyEvent(down))
+            assertFalse(scene.focusManager.hasFocus)
+        } finally {
+            connection.stop()
+            scene.close()
+            frameRecomposer.close()
+        }
+    }
