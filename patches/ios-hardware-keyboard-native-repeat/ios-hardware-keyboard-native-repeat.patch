+package androidx.compose.ui.text.input
+
+import androidx.compose.ui.input.key.Key
+import androidx.compose.ui.input.key.KeyEvent
+import androidx.compose.ui.input.key.KeyEventType
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class HardwareKeyboardRepeatBridgeTest {
+    @Test
+    fun verticalNavigationConsumesInitialNativeEchoThenRepeatsFromLaterTicks() {
+        val repeats = mutableListOf<KeyEvent>()
+        val bridge = HardwareKeyboardRepeatBridge(repeats::add)
+        val event = keyDown(Key.DirectionDown)
+
+        assertTrue(bridge.begin(event, hasActiveComposition = false))
+        assertTrue(bridge.onSelectionChange())
+        assertEquals(emptyList(), repeats)
+
+        assertTrue(bridge.onSelectionChange())
+        assertEquals(listOf(event), repeats)
+    }
+
+    @Test
+    fun forwardDeleteConsumesSelectionPreludeAndUsesDeleteBackwardAsTick() {
+        val repeats = mutableListOf<KeyEvent>()
+        val bridge = HardwareKeyboardRepeatBridge(repeats::add)
+        val event = keyDown(Key.Delete)
+
+        assertTrue(bridge.begin(event, hasActiveComposition = false))
+        assertTrue(bridge.onSelectionChange())
+        assertTrue(bridge.onDeleteBackward())
+        assertEquals(emptyList(), repeats)
+
+        assertTrue(bridge.onSelectionChange())
+        assertTrue(bridge.onDeleteBackward())
+        assertEquals(listOf(event), repeats)
+    }
+
+    @Test
+    fun visibleCompositionAndNativeOwnedKeysDoNotArmTheBridge() {
+        val bridge = HardwareKeyboardRepeatBridge {}
+
+        assertFalse(bridge.begin(keyDown(Key.DirectionUp), hasActiveComposition = true))
+        assertFalse(bridge.begin(keyDown(Key.DirectionLeft), hasActiveComposition = false))
+        assertFalse(bridge.begin(keyDown(Key.Backspace), hasActiveComposition = false))
+        assertFalse(bridge.onSelectionChange())
+        assertFalse(bridge.onDeleteBackward())
+    }
+
+    @Test
+    fun shiftVerticalNavigationIsEligibleButOtherModifiersAreNot() {
+        val bridge = HardwareKeyboardRepeatBridge {}
+
+        assertTrue(
+            bridge.begin(
+                keyDown(Key.DirectionUp, isShiftPressed = true),
+                hasActiveComposition = false,
+            )
+        )
+        bridge.reset()
+        assertFalse(
+            bridge.begin(
+                keyDown(Key.DirectionUp, isAltPressed = true),
+                hasActiveComposition = false,
+            )
+        )
+    }
+
+    @Test
+    fun secondEditingPressCannotStealAnonymousNativeTicks() {
+        val repeats = mutableListOf<KeyEvent>()
+        val bridge = HardwareKeyboardRepeatBridge(repeats::add)
+        val down = keyDown(Key.DirectionDown)
+
+        assertTrue(bridge.begin(down, hasActiveComposition = false))
+        assertFalse(bridge.begin(keyDown(Key.DirectionUp), hasActiveComposition = false))
+        assertTrue(bridge.onSelectionChange())
+        assertTrue(bridge.onSelectionChange())
+        assertEquals(listOf(down), repeats)
+    }
+
+    @Test
+    fun keyUpAndResetClearTheActiveRepeatSource() {
+        val bridge = HardwareKeyboardRepeatBridge {}
+        val event = keyDown(Key.DirectionDown)
+
+        assertTrue(bridge.begin(event, hasActiveComposition = false))
+        bridge.end()
+        assertFalse(bridge.onSelectionChange())
+
+        assertTrue(bridge.begin(event, hasActiveComposition = false))
+        bridge.reset()
+        assertFalse(bridge.onSelectionChange())
+    }
+
+    @Test
+    fun repeatDispatchSelectionUpdatesAreConsumedWithoutRecursing() {
+        lateinit var bridge: HardwareKeyboardRepeatBridge
+        var repeatCount = 0
+        bridge =
+            HardwareKeyboardRepeatBridge {
+                repeatCount += 1
+                assertTrue(bridge.onSelectionChange())
+            }
+
+        assertTrue(bridge.begin(keyDown(Key.DirectionDown), hasActiveComposition = false))
+        assertTrue(bridge.onSelectionChange())
+        assertTrue(bridge.onSelectionChange())
+        assertEquals(1, repeatCount)
+    }
+}
+
+private fun keyDown(
+    key: Key,
+    isShiftPressed: Boolean = false,
+    isAltPressed: Boolean = false,
+): KeyEvent =
+    KeyEvent(
+        key = key,
+        type = KeyEventType.KeyDown,
+        isShiftPressed = isShiftPressed,
+        isAltPressed = isAltPressed,
+    )
