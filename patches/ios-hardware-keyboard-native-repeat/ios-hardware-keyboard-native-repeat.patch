+package androidx.compose.ui.text.input
+
+import androidx.compose.ui.input.key.Key
+import androidx.compose.ui.input.key.KeyEvent
+import androidx.compose.ui.input.key.KeyEventType
+import androidx.compose.ui.input.key.isAltPressed
+import androidx.compose.ui.input.key.isCtrlPressed
+import androidx.compose.ui.input.key.isMetaPressed
+import androidx.compose.ui.input.key.isShiftPressed
+import androidx.compose.ui.input.key.key
+import androidx.compose.ui.input.key.type
+
+internal class HardwareKeyboardRepeatBridge(
+    private val onRepeat: (KeyEvent) -> Unit,
+) {
+    private var activePress: ActiveHardwareKeyboardPress? = null
+    private var dispatchingRepeat = false
+
+    fun begin(event: KeyEvent, hasActiveComposition: Boolean): Boolean {
+        if (hasActiveComposition || event.type != KeyEventType.KeyDown || activePress != null) {
+            return false
+        }
+        val source = event.nativeRepeatSource() ?: return false
+        activePress = ActiveHardwareKeyboardPress(event, source)
+        return true
+    }
+
+    fun end(): Boolean {
+        if (activePress == null) return false
+        activePress = null
+        return true
+    }
+
+    fun reset() {
+        activePress = null
+        dispatchingRepeat = false
+    }
+
+    fun onSelectionChange(): Boolean {
+        val active = activePress ?: return false
+        if (dispatchingRepeat) return true
+        return when (active.source) {
+            NativeRepeatSource.SelectionChange -> active.consumeTick()
+            NativeRepeatSource.DeleteBackward -> true
+        }
+    }
+
+    fun onDeleteBackward(): Boolean {
+        val active = activePress ?: return false
+        if (dispatchingRepeat) return true
+        return when (active.source) {
+            NativeRepeatSource.SelectionChange -> false
+            NativeRepeatSource.DeleteBackward -> active.consumeTick()
+        }
+    }
+
+    private fun ActiveHardwareKeyboardPress.consumeTick(): Boolean {
+        if (!initialEchoConsumed) {
+            initialEchoConsumed = true
+            return true
+        }
+        dispatchingRepeat = true
+        try {
+            onRepeat(event)
+        } finally {
+            dispatchingRepeat = false
+        }
+        return true
+    }
+}
+
+private data class ActiveHardwareKeyboardPress(
+    val event: KeyEvent,
+    val source: NativeRepeatSource,
+    var initialEchoConsumed: Boolean = false,
+)
+
+private enum class NativeRepeatSource {
+    SelectionChange,
+    DeleteBackward,
+}
+
+private fun KeyEvent.nativeRepeatSource(): NativeRepeatSource? {
+    if (isCtrlPressed || isAltPressed || isMetaPressed) return null
+    return when (key) {
+        Key.DirectionUp,
+        Key.DirectionDown -> NativeRepeatSource.SelectionChange
+        Key.Delete -> NativeRepeatSource.DeleteBackward.takeUnless { isShiftPressed }
+        else -> null
+    }
+}
