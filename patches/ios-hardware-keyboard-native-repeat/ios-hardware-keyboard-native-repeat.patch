+package androidx.compose.ui.scene
+
+import androidx.compose.ui.input.key.Key
+import androidx.compose.ui.input.key.KeyEvent
+import androidx.compose.ui.input.key.KeyEventType
+import kotlin.test.Test
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class HardwareKeyboardRoutingPolicyTest {
+    @Test
+    fun textAndEditingKeysStayNativeDuringComposition() {
+        assertTrue(keyDown(Key.A, codePoint = 'a'.code).isNativeCompositionInput())
+        assertTrue(keyDown(Key.DirectionUp, isMetaPressed = true).isNativeCompositionInput())
+        assertTrue(keyDown(Key.Delete).isNativeCompositionInput())
+    }
+
+    @Test
+    fun modifiedApplicationShortcutsRemainDispatchableDuringComposition() {
+        assertFalse(
+            keyDown(Key.B, codePoint = 'b'.code, isMetaPressed = true)
+                .isNativeCompositionInput()
+        )
+        assertFalse(keyDown(Key.F12, isCtrlPressed = true).isNativeCompositionInput())
+    }
+}
+
+private fun keyDown(
+    key: Key,
+    codePoint: Int = 0,
+    isCtrlPressed: Boolean = false,
+    isMetaPressed: Boolean = false,
+): KeyEvent =
+    KeyEvent(
+        key = key,
+        type = KeyEventType.KeyDown,
+        codePoint = codePoint,
+        isCtrlPressed = isCtrlPressed,
+        isMetaPressed = isMetaPressed,
+    )
