+@OptIn(ExperimentalForeignApi::class, ExperimentalCoroutinesApi::class)
+class TextInputConnectionIosTest {
+    @Test
+    fun nativeEditsInTheSameTurnAreDispatchedAsOneEdit() = runTest {
+        val request = TestRequest(TextFieldValue("ab", TextRange(2)))
+        val connection = TestTextInputConnection(CoroutineScope(coroutineContext))
+        connection.start(request)
+
+        connection.setSelectedTextRange(TextRange(0, 2))
+        connection.insertText("c")
+
+        assertEquals(emptyList(), request.dispatchedCommands)
+
+        runCurrent()
+
+        assertEquals(
+            listOf(
+                listOf(
+                    SetSelectionCommand(0, 2),
+                    CommitTextCommand("c", 1),
+                )
+            ),
+            request.dispatchedCommands,
+        )
+        assertEquals(TextFieldValue("c", TextRange(1)), request.value())
+        assertEquals(emptyList(), connection.stateWillChanges)
+        assertEquals(emptyList(), connection.stateDidChanges)
+    }
+
+    @Test
+    fun externallyRewrittenEditNotifiesTheNativeTextInputDelegate() = runTest {
+        val request = TestRequest(TextFieldValue())
+        request.resultOverride = TextFieldValue("!!!", TextRange(3))
+        val connection = TestTextInputConnection(CoroutineScope(coroutineContext))
+        connection.start(request)
+
+        connection.insertText("ㅇ")
+
+        assertEquals("ㅇ", connection.textInRange(TextRange(0, 1)))
+
+        runCurrent()
+
+        assertEquals("!!!", connection.textInRange(TextRange(0, 3)))
+        assertEquals(listOf(true to true), connection.stateWillChanges)
+        assertEquals(listOf(true to true), connection.stateDidChanges)
+    }
+
+    @Test
+    fun externallyCommittedCompositionNotifiesTheNativeTextInputDelegate() = runTest {
+        val connection = TestTextInputConnection(CoroutineScope(coroutineContext))
+        connection.start(
+            TestRequest(
+                TextFieldValue(
+                    text = "하",
+                    selection = TextRange(1),
+                    composition = TextRange(0, 1),
+                )
+            )
+        )
+
+        connection.onTextFieldValueUpdated(
+            TextFieldValue(
+                text = "하",
+                selection = TextRange(1),
+                composition = null,
+            )
+        )
+
+        assertEquals(listOf(true to true), connection.stateWillChanges)
+        assertEquals(listOf(true to true), connection.stateDidChanges)
+    }
+
+    @Test
+    fun staleStateUpdateDoesNotReplaceThePendingNativeEditPrediction() = runTest {
+        val initialValue = TextFieldValue()
+        val request = TestRequest(initialValue)
+        val connection = TestTextInputConnection(CoroutineScope(coroutineContext))
+        connection.start(request)
+
+        connection.insertText("c")
+        connection.onTextFieldValueUpdated(initialValue)
+        connection.insertText("d")
+
+        assertEquals("cd", connection.textInRange(TextRange(0, 2)))
+
+        runCurrent()
+
+        assertEquals(TextFieldValue("cd", TextRange(2)), request.value())
+        assertEquals(emptyList(), connection.stateWillChanges)
+        assertEquals(emptyList(), connection.stateDidChanges)
+    }
+
+    @Test
+    fun stoppingTheConnectionDiscardsPendingNativeEdits() = runTest {
+        val request = TestRequest(TextFieldValue())
+        val connection = TestTextInputConnection(CoroutineScope(coroutineContext))
+        connection.start(request)
+
+        connection.insertText("a")
+        connection.stop()
+
+        runCurrent()
+
+        assertEquals(emptyList(), request.dispatchedCommands)
+        assertEquals(TextFieldValue(), request.value())
+    }
+}
+
+@OptIn(ExperimentalForeignApi::class)
+private class TestTextInputConnection(
+    scope: CoroutineScope,
+) : TextInputConnection(
+    updateView = {},
+    view = UIView(frame = CGRectZero.readValue()),
+    coroutineScope = scope,
+    focusedViewsList = null,
+    focusManager = { null },
+) {
+    val stateWillChanges = mutableListOf<Pair<Boolean, Boolean>>()
+    val stateDidChanges = mutableListOf<Pair<Boolean, Boolean>>()
+
+    override val textInputView: UIView
+        get() = view
+
+    override fun attachInputToView() = Unit
+
+    override fun detachView() = Unit
+
+    override fun showKeyboard() = Unit
+
+    override fun dismissKeyboard() = Unit
+
+    override fun stateWillChange(textChanged: Boolean, selectionChanged: Boolean) {
+        stateWillChanges += textChanged to selectionChanged
+    }
+
+    override fun stateDidChange(textChanged: Boolean, selectionChanged: Boolean) {
+        stateDidChanges += textChanged to selectionChanged
+    }
+
+    override fun onViewGeometryUpdated() = Unit
+
+    override fun setAvailableEditMenuActions(
+        copy: (() -> Unit)?,
+        paste: (() -> Unit)?,
+        cut: (() -> Unit)?,
+        selectAll: (() -> Unit)?,
+        customActions: List<androidx.compose.ui.platform.UIKitNativeTextInputContextMenuCustomAction>?,
+    ) = Unit
+}
+
+private class TestRequest(initialValue: TextFieldValue) : PlatformTextInputMethodRequest {
+    private var fieldValue = initialValue
+
+    val dispatchedCommands = mutableListOf<List<EditCommand>>()
+    var resultOverride: TextFieldValue? = null
+
+    override val value: () -> TextFieldValue = { fieldValue }
+
+    override val state: TextEditorState =
+        object : TextEditorState {
+            override val selection: TextRange
+                get() = fieldValue.selection
+
+            override val composition: TextRange?
+                get() = fieldValue.composition
+
+            override val text: String
+                get() = fieldValue.text
+
+            override val length: Int
+                get() = fieldValue.text.length
+
+            override fun get(index: Int): Char = fieldValue.text[index]
+
+            override fun subSequence(startIndex: Int, endIndex: Int): CharSequence =
+                fieldValue.text.subSequence(startIndex, endIndex)
+        }
+
+    override val imeOptions: ImeOptions = ImeOptions.Default
+
+    override val onEditCommand: (List<EditCommand>) -> Unit = {}
+
+    override val onImeAction: ((ImeAction) -> Unit)? = null
+
+    override val textLayoutResult: () -> TextLayoutResult? = { null }
+
+    override val focusedRectInRoot: () -> Rect? = { null }
+
+    override val textFieldRectInRoot: () -> Rect? = { null }
+
+    override val textClippingRectInRoot: () -> Rect? = { null }
+
+    override val unclippedTextOffsetInRoot: () -> Offset? = { null }
+
+    override val editText: (block: TextEditingScope.() -> Unit) -> Unit = { block ->
+        val commands = mutableListOf<EditCommand>()
+        TestTextEditingScope(commands).block()
+        dispatchedCommands += commands
+        fieldValue =
+            resultOverride
+                ?: EditProcessor().also { it.reset(fieldValue, null) }.apply(commands)
+    }
+}
+
+private fun TestTextEditingScope(commands: MutableList<EditCommand>) =
+    object : TextEditingScope {
+        override fun deleteSurroundingTextInCodePoints(
+            lengthBeforeCursor: Int,
+            lengthAfterCursor: Int,
+        ) {
+            commands +=
+                DeleteSurroundingTextInCodePointsCommand(
+                    lengthBeforeCursor,
+                    lengthAfterCursor,
+                )
+        }
+
+        override fun setSelection(start: Int, end: Int) {
+            commands += SetSelectionCommand(start, end)
+        }
+
+        override fun commitText(text: CharSequence, newCursorPosition: Int) {
+            commands += CommitTextCommand(text.toString(), newCursorPosition)
+        }
+
+        override fun setComposingRegion(start: Int, end: Int) {
+            commands += SetComposingRegionCommand(start, end)
+        }
+
+        override fun setComposingText(text: CharSequence, newCursorPosition: Int) {
+            commands += SetComposingTextCommand(text.toString(), newCursorPosition)
+        }
+
+        override fun finishComposingText() {
+            commands += FinishComposingTextCommand()
+        }
+    }
