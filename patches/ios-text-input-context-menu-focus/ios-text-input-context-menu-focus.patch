+import kotlin.test.assertNotNull
+import platform.UIKit.UIPasteboard
+
+@OptIn(ExperimentalTestApi::class, ExperimentalComposeUiApi::class, InternalComposeUiApi::class)
+class TextInputContextMenuFocusTest {
+    @Test
+    fun unfocusedFieldsCannotHandleSystemPaste() {
+        for (stateBased in listOf(false, true)) {
+            runComposeUiTest {
+                val context = TestTextInputContext()
+                val title = TestField(stateBased)
+                val subtitle = TestField(stateBased)
+                val body = FocusRequester()
+                setContent {
+                    CompositionLocalProvider(
+                        LocalNativeTextInputContext provides context,
+                        LocalClipboard provides TestClipboard,
+                    ) {
+                        Column {
+                            title.Content()
+                            subtitle.Content()
+                            Box(Modifier.size(40.dp).focusRequester(body).focusable())
+                        }
+                    }
+                }
+                runOnIdle { body.requestFocus() }
+                runOnIdle { context.paste?.invoke() }
+                runOnIdle {
+                    assertEquals("", title.text)
+                    assertEquals(
+                        "",
+                        subtitle.text,
+                        "An unfocused field must not receive system paste",
+                    )
+                }
+            }
+        }
+    }
+
+    @Test
+    fun systemPasteFollowsFocusBetweenFields() {
+        for (stateBased in listOf(false, true)) {
+            runComposeUiTest {
+                val context = TestTextInputContext()
+                val title = TestField(stateBased)
+                val subtitle = TestField(stateBased)
+                setContent {
+                    CompositionLocalProvider(
+                        LocalNativeTextInputContext provides context,
+                        LocalClipboard provides TestClipboard,
+                    ) {
+                        Column {
+                            title.Content()
+                            subtitle.Content()
+                        }
+                    }
+                }
+                runOnIdle { title.focusRequester.requestFocus() }
+                runOnIdle { assertNotNull(context.paste).invoke() }
+                runOnIdle {
+                    assertEquals("pasted", title.text)
+                    assertEquals("", subtitle.text)
+                    subtitle.focusRequester.requestFocus()
+                }
+                runOnIdle { assertNotNull(context.paste).invoke() }
+                runOnIdle {
+                    assertEquals("pasted", title.text)
+                    assertEquals("pasted", subtitle.text)
+                }
+            }
+        }
+    }
+
+    @Test
+    fun previousPasteCallbackCannotMutateFieldAfterFocusMoves() {
+        for (stateBased in listOf(false, true)) {
+            runComposeUiTest {
+                val context = TestTextInputContext()
+                val field = TestField(stateBased)
+                val body = FocusRequester()
+                setContent {
+                    CompositionLocalProvider(
+                        LocalNativeTextInputContext provides context,
+                        LocalClipboard provides TestClipboard,
+                    ) {
+                        Column {
+                            field.Content()
+                            Box(Modifier.size(40.dp).focusRequester(body).focusable())
+                        }
+                    }
+                }
+                runOnIdle { field.focusRequester.requestFocus() }
+                runOnIdle {
+                    val previousPaste = assertNotNull(context.paste)
+                    body.requestFocus()
+                    // UIKit can invoke an already installed action before recomposition.
+                    previousPaste()
+                }
+                runOnIdle { assertEquals("", field.text) }
+            }
+        }
+    }
+
+    private class TestField(private val stateBased: Boolean) {
+        val focusRequester = FocusRequester()
+        private var value by mutableStateOf(TextFieldValue())
+        private val state = TextFieldState()
+        val text: String
+            get() = if (stateBased) state.text.toString() else value.text
+
+        @Composable
+        fun Content() {
+            if (stateBased) {
+                BasicTextField(state, Modifier.focusRequester(focusRequester))
+            } else {
+                BasicTextField(value, { value = it }, Modifier.focusRequester(focusRequester))
+            }
+        }
+    }
+
+    private object TestClipboard : Clipboard {
+        override val nativeClipboard: NativeClipboard =
+            UIPasteboard.pasteboardWithUniqueName().apply { string = "pasted" }
+
+        override suspend fun getClipEntry(): ClipEntry = ClipEntry.withPlainText("pasted")
+
+        override suspend fun setClipEntry(clipEntry: ClipEntry?) = Unit
+    }
+
+    private class TestTextInputContext : UIKitNativeTextInputContext {
+        var paste: (() -> Unit)? = null
+
+        override fun usingNativeTextInput(): Boolean = false
+
+        override fun updateNativeTextInputTintColor(color: Color?) = Unit
+
+        override fun updateNativeTextInputEditMenuState(
+            copy: (() -> Unit)?,
+            paste: (() -> Unit)?,
+            cut: (() -> Unit)?,
+            selectAll: (() -> Unit)?,
+            customActions: List<UIKitNativeTextInputContextMenuCustomAction>?,
+        ) {
+            this.paste = paste
+        }
+    }
+}
