+package androidx.compose.ui.platform
+
+import androidx.compose.ui.ExperimentalComposeUiApi
+import platform.UIKit.UIView
+
+/**
+ * A text input request that integrates with its UIKit text input view.
+ *
+ * The view belongs to Compose. Callbacks may configure session-specific integration, but must not
+ * remove the view or change its input connection. Requests without this interface are unaffected.
+ *
+ * @sample androidx.compose.ui.samples.UIKitTextInputMethodRequestSample
+ */
+@ExperimentalComposeUiApi
+interface UIKitTextInputMethodRequest : PlatformTextInputMethodRequest {
+    /** Called after the input view is connected, before Compose requests keyboard presentation. */
+    fun onTextInputViewAttached(view: UIView)
+
+    /**
+     * Called once for each completed [onTextInputViewAttached] when this request stops using the
+     * input view, including request replacement. If the connection ends during attachment, cleanup
+     * runs immediately after the attachment callback returns, never before or inside it.
+     */
+    fun onTextInputViewDetached(view: UIView)
+}
